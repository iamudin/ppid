# Matikan eksekusi script PHP / Shell / CGI di direktori upload asset
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|phar|pht|sh|pl|cgi|exe|py|asp|aspx|shtml)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

<FilesMatch "^\.">
    Order Deny,Allow
    Deny from all
</FilesMatch>

Options -Indexes -ExecCGI
